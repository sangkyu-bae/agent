# ──────────────────────────────────────────
# sangplusbot — Root .gitignore
# 각 서브프로젝트(idt/, idt_front/)의 .gitignore와 병용됨
# ──────────────────────────────────────────

# OS artifacts
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*.suo

# Environment variables (절대 커밋 금지)
.env
.env.*
!.env.example
!.env.local.example

# bkit / PDCA 상태 (로컬 전용, 자동 생성)
.bkit/runtime/
.bkit/snapshots/
.bkit/state/
# 체크포인트 JSON 은 로컬 전용 — diff 노이즈가 커서 커밋 대상에서 제외 (idt/·idt_front/ 하위 포함)
**/.bkit/checkpoints/

# Claude Code 로컬 설정 (개인 전용)
.claude/settings.local.json
.claude/agent-memory/

# Python (서브프로젝트가 루트에서 실행될 경우 대비)
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node (서브프로젝트가 루트에서 실행될 경우 대비)
node_modules/

# Logs
logs/
*.log

# 임시/업로드 파일
tmp/
temp/
uploads/

# 빌드 산출물
dist/
build/

# 개인 커리어/이력서 관련 (커밋 금지)
docs/analyze/
docs/career/
idt/docs/analyze/
idt/docs/career/
idt/.claude/commands/tailor-resume.md
idt/.claude/agents/jd-analyzer.md
idt/.claude/agents/project-analyzer.md
idt/.claude/agents/resume-writer.md
idt/.claude/agents/strength-matcher.md
idt/work/

# 테스트용 문서
idt/test-docs/

# 문서 이미지 (로컬 전용)
**/docs/img/


# 소개/포트폴리오 자료 (로컬 전용, 커밋 금지)
docs/intro/

# 사내 발표 덱 (로컬 전용, 커밋 금지)
docs/presentations/
.claude/commands/Present.md
.claude/agents/presentation-builder.md
scripts/render_pdf.py
